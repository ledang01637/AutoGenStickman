# ==========================================
# === ENVIRONMENT & APP CONFIGURATION ======
# ==========================================
ENV=production
APP_NAME=autogen_api
API_BASE_URL=https://api.your-domain.com
CLIENT_URL=https://your-domain.com

# ==========================================
# === AI & EXTERNAL API KEYS ===============
# ==========================================
GEMINI_API_KEY=xxx
FAL_KEY=xxx
ANTHROPIC_API_KEY=sxxx
VBEE_API_KEY=xxx
VBEE_APP_ID=xxx

# ==========================================
# === DATABASE (POSTGRESQL) ================
# ==========================================
POSTGRES_USER=xxxx
POSTGRES_PASSWORD=xxx
POSTGRES_DB=xxxx
DATABASE_URL=postgresql+asyncpg://xxxx:xxx@db:5432/xxx

# ==========================================
# === REDIS ================================
# ==========================================
REDIS_PASSWORD=xxx
REDIS_URL=redis://:xxx@redis:6379/0

# ==========================================
# === AUTHENTICATION & JWT =================
# ==========================================
SECRET_KEY=xxx
ALGORITHM=xxx
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

# ==========================================
# === CORS & ORIGINS =======================
# ==========================================
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==========================================
# === GOOGLE OAUTH =========================
# ==========================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# ==========================================
# === PAYMENTS (PAYOS) =====================
# ==========================================
PAYOS_CLIENT_ID=xxx
PAYOS_API_KEY=xxx
PAYOS_CHECKSUM_KEY=xxx
PAYOS_RETURN_URL=xxx
PAYOS_CANCEL_URL=xxx
CREDIT_PRICE_VND=1000  # 1000đ / credit khi top-up

# ==========================================
# === BUSINESS LOGIC & COST CONTROL ========
# ==========================================
MAX_DAILY_COST_VND=xxx
COST_PER_VIDEO_VND=xxx